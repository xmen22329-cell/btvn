<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Bài 2.11 - Đăng ký Thông tin</title>
</head>
<body>


    <div style="border: 4px solid #9c27b0; background-color: #fffde7; max-width: 650px; margin: 20px auto; padding: 30px; font-family: Arial, sans-serif;">
        

        <h1 align="center" style="margin-bottom: 5px; font-weight: normal; font-size: 32px;">
            Đăng ký <span style="font-weight: bold; font-size: 38px;">Thông tin</span>
        </h1>
        

        <p align="center" style="font-size: 13px; color: #333; margin-top: 5px; margin-bottom: 25px;">
            Để nhận thông tin tư vấn về chương trình, vui lòng điền đầy đủ thông tin dưới đây,<br>
            chúng tôi sẽ liên hệ với bạn sớm nhất
        </p>

        <form action="" method="post">
            <table align="center" cellpadding="6" cellspacing="0" border="0" width="100%">

                <tr>
                    <td align="right" width="35%">Họ và tên</td>
                    <td width="65%">
                        <input type="text" name="fullname" style="width: 250px; padding: 3px;">
                        <span style="color: red;">*</span>
                    </td>
                </tr>


                <tr>
                    <td align="right">Năm sinh</td>
                    <td>
                        <input type="text" name="birthyear" style="width: 250px; padding: 3px;">
                        <span style="color: red;">*</span>
                    </td>
                </tr>


                <tr>
                    <td align="right">Điện thoại</td>
                    <td>
                        <input type="text" name="phone" style="width: 250px; padding: 3px;">
                        <span style="color: red;">*</span>
                    </td>
                </tr>


                <tr>
                    <td align="right">Email</td>
                    <td>
                        <input type="text" name="email" style="width: 250px; padding: 3px;">
                    </td>
                </tr>


                <tr>
                    <td align="right">Sinh viên trường</td>
                    <td>
                        <input type="text" name="school" style="width: 250px; padding: 3px;">
                    </td>
                </tr>


                <tr>
                    <td align="right">Khóa</td>
                    <td>
                        <input type="text" name="course" style="width: 250px; padding: 3px;">
                    </td>
                </tr>

                <tr>
                    <td align="right">Mã bảo mật:</td>
                    <td>
                        <input type="text" name="captcha" style="width: 150px; padding: 3px;">
                        <span style="font-weight: bold; margin-left: 20px; font-size: 16px; letter-spacing: 2px;">530 11 9</span>
                    </td>
                </tr>


                <tr><td colspan="2" height="15"></td></tr>


                <tr>
                    <td colspan="2" align="center">
                        <input type="submit" value="ĐĂNG KÝ" style="background-color: #ab47bc; color: white; border: none; padding: 10px 30px; font-weight: bold; cursor: pointer; border-radius: 3px; margin-right: 15px;">
                        <input type="reset" value="LÀM LẠI" style="background-color: #ab47bc; color: white; border: none; padding: 10px 30px; font-weight: bold; cursor: pointer; border-radius: 3px;">
                    </td>
                </tr>
            </table>
        </form>
    </div>

</body>
</html>
